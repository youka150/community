# Shared PostgreSQL database: replace these example credentials locally.
DATABASE_URL=postgresql://community_user:replace_me@127.0.0.1:5432/community
HUAWEI_MINING_BASE_URL=http://127.0.0.1:8008

# LLM provider settings for AI insights and trend analysis.
TREND_ANALYSIS_API_KEY=
TREND_ANALYSIS_BASE_URL=
TREND_ANALYSIS_MODEL_NAME=

# Search providers for trend analysis.
TAVILY_API_KEY=
BOCHA_API_KEY=
BOCHA_BASE_URL=

# Optional Redis cache. Leave empty to use the in-memory cache.
REDIS_URL=

MAX_REFLECTIONS=2
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT=30
